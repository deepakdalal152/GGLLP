# Authentik stack local .env
# --------------------------
# Database (postgres env vars expected by the postgres image)
POSTGRES_DB=authentik
POSTGRES_USER=authentik
POSTGRES_PASSWORD=SuperSecurePassword123            # <-- if empty, init.sh will auto-generate

# Authentik image / tag
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2025.8.0

# Django secret (will be generated by init.sh if blank)
AUTHENTIK_SECRET_KEY=VoLgt3oppLozS1GfKYMhHxozff6MV8IHvv855zIvPUen2RKYqXvNw7lXeLne

# Optional error reporting (true/false)
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# Network (inherited from top-level .env if not set here)
# Set to same name created by init-all (usually "proxy")
NETWORK_NAME=proxy

# Local host IP for messages (optional; inherited from parent .env if not set)
# HOST_IP=192.168.1.10
