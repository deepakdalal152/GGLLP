# Global settings
NETWORK_NAME=proxy


# Timezone for the PostgreSQL container
TZ=UTC

# PostgreSQL Configuration
POSTGRES_USER=mattermost_user
POSTGRES_PASSWORD=mattermost_password
POSTGRES_DB=mattermost


# Mattermost Database Configuration
MM_SQLSETTINGS_DRIVERNAME=postgres
MM_SQLSETTINGS_DATASOURCE=postgres://mattermost_user:mattermost_password@postgres/mattermost?sslmode=disable
